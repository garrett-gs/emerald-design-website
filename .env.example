# Contact form delivery (Resend). Without RESEND_API_KEY the form still works —
# it falls back to opening a prefilled email in the visitor's mail client.
RESEND_API_KEY=
# Verified Resend sender. Until a domain is verified, "onboarding@resend.dev"
# only delivers to the address the Resend account was created with.
EMAIL_FROM="Emerald Website <onboarding@resend.dev>"
# Where inquiries land. Defaults to site.email in src/lib/site.ts.
CONTACT_TO=
